# =============================================================================
# Asisten Pengetahuan Internal Toko Makmur Jaya — Canonical .env.example
# Environment Schema version: 1.1
# =============================================================================
# INSTRUCTIONS:
# - Copy this file to .env (for demo-vps) or .env.test (for local-isolated)
# - Fill in ALL required values before running any profile
# - Values marked REQUIRED must be non-empty, non-placeholder
# - Values marked UNKNOWN require profiling/decision before runtime-ready
# - NEVER commit actual .env, .env.test, or any secret to version control
# =============================================================================

# -----------------------------------------------------------------------------
# CONTAINER IMAGES (Exact tag/digest required; NO 'latest')
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
N8N_IMAGE=
PGVECTOR_IMAGE=
# Required only for: demo-vps
CADDY_IMAGE=

# -----------------------------------------------------------------------------
# PUBLIC HOSTNAME & TLS (Required only for demo-vps / live Telegram)
# -----------------------------------------------------------------------------
# Required only for: demo-vps (live Telegram webhook)
# Must be a valid FQDN pointing to the exact VPS; no IP, no scheme/path, no .invalid when live
PUBLIC_HOSTNAME=
# Required only for: automatic public TLS (demo-vps)
# Valid email for Let's Encrypt; not .invalid when live
ACME_EMAIL=

# -----------------------------------------------------------------------------
# TIMEZONE & LOCALE
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
# IANA timezone identifier (e.g., Asia/Jakarta)
GENERIC_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# N8N ENCRYPTION KEY (Secret — Human provisions from approved source)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
# Strong random string; consistent for lifecycle; never printed
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# POSTGRESQL BOOTSTRAP (Human provisions secrets from approved source)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
POSTGRES_DB=automation
# Required only for: initialization/maintenance
POSTGRES_USER=cluster_admin
# Required for: local-isolated, demo-vps (Secret)
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# N8N DATABASE ROLE (Least-privilege for n8n schema only)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
N8N_DB_USER=n8n_app
# Required for: local-isolated, demo-vps (Secret)
N8N_DB_PASSWORD=

# -----------------------------------------------------------------------------
# RAG INGEST DATABASE ROLE (Write corpus/staging only)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
RAG_INGEST_DB_USER=rag_ingest
# Required for: local-isolated, demo-vps (Secret)
RAG_INGEST_DB_PASSWORD=

# -----------------------------------------------------------------------------
# RAG RUNTIME DATABASE ROLE (Read corpus + write dedup/safe events only)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
RAG_RUNTIME_DB_USER=rag_runtime
# Required for: local-isolated, demo-vps (Secret)
RAG_RUNTIME_DB_PASSWORD=

# -----------------------------------------------------------------------------
# EMBEDDING DIMENSION (Engineer sets after selecting embedding model)
# -----------------------------------------------------------------------------
# Required before: DB init / ingest
# Positive integer; MUST match actual embedding model output dimension
RAG_EMBEDDING_DIMENSION=

# -----------------------------------------------------------------------------
# AI TIMEOUT BUDGET (Engineer + DevOps set after profiling)
# -----------------------------------------------------------------------------
# Required before: integration / E2E
# Integer milliseconds; must leave headroom for Telegram send < 5000ms total
# UNKNOWN until profiling — template uses empty value
N8N_AI_TIMEOUT_MAX=

# -----------------------------------------------------------------------------
# EXECUTION RETENTION (Architect-set for temporary demo lifecycle)
# -----------------------------------------------------------------------------
# Required for: local-isolated, demo-vps
# Integer hours; not a license to store payloads
EXECUTIONS_DATA_MAX_AGE=24

# =============================================================================
# END OF OPERATOR INPUT VARIABLES
# =============================================================================
# The following variables are FIXED or DERIVED at runtime by Compose.
# They are listed here for auditability but NOT set in .env/.env.test.
# Compose interpolates them from the operator inputs above.
# =============================================================================

# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
# DB_POSTGRESDB_USER=${N8N_DB_USER}
# DB_POSTGRESDB_PASSWORD=${N8N_DB_PASSWORD}
# DB_POSTGRESDB_SCHEMA=n8n
# N8N_HOST=${PUBLIC_HOSTNAME}
# N8N_PORT=5678
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://${PUBLIC_HOSTNAME}/
# N8N_PROXY_HOPS=1
# TZ=${GENERIC_TIMEZONE}
# EXECUTIONS_MODE=regular
# N8N_CONCURRENCY_PRODUCTION_LIMIT=1
# EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
# EXECUTIONS_DATA_SAVE_ON_ERROR=none
# EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
# EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
# EXECUTIONS_DATA_PRUNE=true
# N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# N8N_RESTRICT_FILE_ACCESS_TO=/files/docs
# N8N_DIAGNOSTICS_ENABLED=false
# N8N_PERSONALIZATION_ENABLED=false

# =============================================================================
# AI PROVIDER BINDING (NOT in .env — stored in n8n credential store + rag_settings)
# =============================================================================
# Provider Base URL, Authentication, Chat Model Identity, Embedding Profile,
# and Transport Profile are configured at runtime via:
# - n8n credential store: 'ai-provider' (OpenAI-compatible)
# - Database table: rag_settings (chat_model, embedding_model, embedding_profile_id,
#   retrieval_limit, minimum_similarity, context_bound, output_bound, ai_timeout_max,
#   ingest_timeout_max, config_revision)
# See Environment Schema §3 and §4 for details.
